# Database (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name
# Replace with your PostgreSQL credentials:
# - username: usually "postgres" (or your PostgreSQL username)
# - password: your PostgreSQL password
# - localhost:5432: default PostgreSQL location
# - database_name: name of your database (we'll create "ai_chat_app")
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/ai_chat_app"
